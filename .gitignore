node_modules/
.next/
out/
dist/
coverage/

# 로컬 시크릿 — Vercel env가 정본이고 로컬 파일은 절대 커밋하지 않는다.
# ⚠️ 전에는 `.env` 정확 일치 + `*.local`이라 `.env.production`·`.env.development`가 안 잡혔다
# (sec-audit 발견 18, `git check-ignore` 실측). `.env*`로 넓히고 예시 파일만 되돌린다.
.env*
!.env.example

# 자격증명 파일. 이 패턴이 뚫리면 리포 쓰기 권한이 새어나간다.
*.pem
*.key
*.p12
*.pfx

.DS_Store
*.tsbuildinfo
.vercel

# 머신별 권한 허용 목록 — 공유할 값이 아니다.
.claude/settings.local.json

# 폰트 동적 서브셋 — scripts/copy-fonts.mjs 생성물 (3MB, 92파일)
public/fonts/

# Prisma 7 생성 클라이언트 — prisma generate 산출물
generated/

# 일회성 실험 스크립트. **리포 안이어야 tsconfig·경로 별칭이 잡히고**, gitignore돼야
# `git add -A`에 딸려가지 않는다 — 2026-09-03에 `.b3-*.ts` 둘이 그렇게 커밋됐다.
/.scratch/
