{
  "name": "malmoi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/copy-fonts.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-fonts.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "scan": "tsx scripts/scan.ts",
    "ingest": "tsx scripts/ingest.ts",
    "push:local": "tsx scripts/push-local.ts",
    "smoke:github": "tsx scripts/smoke-github.ts",
    "adapter-survey": "tsx scripts/adapter-survey.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "PRISMA_TARGET=prod prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:status:prod": "PRISMA_TARGET=prod prisma migrate status",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "sync:agents": "node scripts/sync-agents.mjs",
    "sync:agents:check": "node scripts/sync-agents.mjs --check",
    "credentials:dev": "CREDENTIAL_TARGET=dev NODE_OPTIONS=--conditions=react-server tsx scripts/credentials.ts",
    "credentials:prod": "CREDENTIAL_TARGET=prod NODE_OPTIONS=--conditions=react-server tsx scripts/credentials.ts",
    "test:credentials:postgres": "vitest run --config vitest.credentials.config.ts",
    "credentials:finalize:dev": "CREDENTIAL_TARGET=dev NODE_OPTIONS=--conditions=react-server tsx scripts/finalize-credentials.ts",
    "credentials:finalize:prod": "CREDENTIAL_TARGET=prod NODE_OPTIONS=--conditions=react-server tsx scripts/finalize-credentials.ts"
  },
  "devDependencies": {
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "dotenv": "^17.4.2",
    "jsdom": "27.4.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@octokit/oauth-app": "8.0.4",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.37.0",
    "next": "^16.3.3",
    "next-auth": "5.0.0-beta.32",
    "octokit": "^5.0.5",
    "pg": "^8.23.0",
    "pretendard": "^1.3.9",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^28.0.0",
    "yaml": "2.9.0",
    "zod": "^4.5.4"
  }
}
