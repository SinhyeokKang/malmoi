# ─── Supabase Postgres ──────────────────────────────────────────────────────
# 런타임은 pooler(6543), 마이그레이션은 direct(5432). 이 둘을 바꿔 쓰면
# 서버리스에서 커넥션이 고갈되거나(direct) 마이그레이션이 실패한다(pooler는 DDL 세션을 못 잡는다).
DATABASE_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ─── Auth.js (GitHub OAuth — 로그인·인가 전용) ───────────────────────────────
AUTH_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# 이 org 멤버만 편집 UI에 진입한다. 비면 아무도 못 들어온다(fail-closed).
AUTH_ALLOWED_ORG=""

# ─── GitHub App (l10n/sync 쓰기 전용 — 사용자 토큰으로 커밋하지 않는다) ──────
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_INSTALLATION_ID=""

# ─── 대상 리포 ──────────────────────────────────────────────────────────────
TARGET_REPO_OWNER=""
TARGET_REPO_NAME=""
TARGET_BASE_BRANCH="main"

# ─── CI push 엔드포인트 인증 ────────────────────────────────────────────────
# GitHub Actions가 /api/push를 부를 때 쓰는 Bearer 토큰. Actions secret과 동일 값.
PUSH_TOKEN=""

# ─── cron ───────────────────────────────────────────────────────────────────
# Vercel Cron이 /api/pull을 부를 때 쓰는 시크릿.
CRON_SECRET=""
