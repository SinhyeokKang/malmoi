# ─── Supabase Postgres — **dev와 prod가 별 프로젝트다** (2026-09-04 분리) ────
# dev: malmoi-dev (ref bfugwmjubgmmroevrave) / prod: i18n-poc (ref xgsyyapzkpbdtkrprlmn)
#
# ⚠️ **로컬·Preview는 dev를, 프로덕션 배포만 prod를 본다.** 분리 전에는 인스턴스가 하나여서
#    `migrate dev`가 프로덕션을 직접 바꿨고, 리셋 제안을 한 번 승인하면 번역이 전부 날아갔다.
#
# 접속 문자열은 대시보드 > Project Settings > Database > Connection string에서
# 그대로 복사한다 — pooler 호스트명에 리전이 들어가므로 손으로 조립하지 않는다.
# 런타임은 transaction 모드 pooler(6543), 마이그레이션은 session 모드 pooler(5432).
# 이 둘을 바꿔 쓰면 prepared statement가 충돌하거나(6543에 마이그레이션) 서버리스에서
# 커넥션이 고갈된다(5432에 런타임). db.<ref>.supabase.co 직결은 IPv6 전용이라 Vercel에서
# 안 붙으므로 마이그레이션도 pooler를 쓴다. <pw>만 실제 비밀번호로 바꾼다.
# ⚠️ 비밀번호에 특수문자가 있으면 URL 인코딩한다(@ → %40, ! → %21, # → %23, / → %2F).
#    인코딩 안 하면 @가 호스트 구분자와 충돌하고, 두 번 인코딩하면 조용히 인증 실패한다.
#    특수문자 없는 영숫자로 발급받는 편이 낫다.
# 런타임(6543)·마이그레이션(5432) — 둘 다 **dev**를 가리킨다.
DATABASE_URL="postgresql://postgres.<dev-ref>:<pw>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<dev-ref>:<pw>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# **prod 마이그레이션 전용** — `pnpm db:deploy`·`pnpm db:status:prod`만 읽는다
# (`prisma.config.ts`가 `PRISMA_TARGET=prod`일 때 이쪽으로 간다).
#
# ⚠️ **prod 런타임 URL(`DATABASE_URL_PROD`)은 두지 않는다.** 로컬에서 프로덕션에 붙는 정당한
#    작업은 마이그레이션 하나뿐이고, 런타임 URL을 두면 로컬 코드가 프로덕션을 가리킬 길이
#    다시 열린다. 프로덕션 데이터는 Supabase 대시보드로 본다.
DIRECT_URL_PROD="postgresql://postgres.<prod-ref>:<pw>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# ─── Auth.js (GitHub OAuth — 로그인·인가 전용) ───────────────────────────────
AUTH_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# 편집 UI에 들어올 GitHub 핸들. 쉼표 구분, 대소문자 무시.
# ⚠️ **비면 아무도 못 들어온다(fail-closed).** 빈 값을 "제한 없음"으로 읽으면 설정 누락이
#    곧 전면 공개가 된다. org 멤버십을 안 쓰는 이유는 대상이 개인 계정 리포라
#    멤버십이 존재하지 않기 때문이다 (MVP §5).
AUTH_ALLOWED_LOGINS=""
# 예: AUTH_ALLOWED_LOGINS="alice,bob-kim"  (계정이 여러 개면 전부 나열한다 —
#     브라우저에 로그인된 계정이 리포 소유자와 다를 수 있다)

# ─── GitHub App (l10n/sync 쓰기 전용 — 사용자 토큰으로 커밋하지 않는다) ──────
# App 자체는 앱 단위라 환경변수, **설치 id는 고객별이라 Project.installationId 컬럼**이다.
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""

# ─── 운영 대상 프로젝트 ─────────────────────────────────────────────────────
# 대상 리포(owner·name·baseBranch)와 GitHub App 설치 id는 Project 테이블 컬럼으로
# 내려갔다 — 고객마다 다르기 때문이다. 여기엔 "지금 어느 프로젝트를 운영하는가"만 남는다.
# 테넌트별 인증·인가가 들어오면(MVP §7) 이 변수는 사라지고 세션이 프로젝트를 결정한다.
ACTIVE_PROJECT_SLUG=""

# ─── CI push 엔드포인트 인증 ────────────────────────────────────────────────
# GitHub Actions가 /api/push를 부를 때 쓰는 Bearer 토큰. Actions secret과 동일 값.
PUSH_TOKEN=""

# ─── cron ───────────────────────────────────────────────────────────────────
# Vercel Cron이 /api/pull을 부를 때 쓰는 시크릿.
CRON_SECRET=""
