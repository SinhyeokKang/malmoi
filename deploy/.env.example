# Malmoi 셀프 호스팅 compose 설정 예제. `cp .env.example .env` 뒤 채운다 — compose가 이 디렉터리의 .env를 보간에 쓴다.
# ⚠️ 키 집합은 compose.yaml이 보간하는 이름과 정확히 같다(`lib/deployment/__tests__/self-hosted-gates.test.ts`가 센다).
# ⚠️ 이 파일의 값은 비밀이다 — 권한을 600으로 두고 리포·백업 사본과 함께 공유하지 않는다. 키는 DB 백업과 **쌍으로** 보관한다.
# ⚠️ 호스팅 서비스(mal-moi.com)의 값을 복사하지 않는다 — OAuth·App·서명·암호화 키는 전부 운영자 자신의 것이다.
# 값에 `$`가 있으면 compose가 보간한다 — 작은따옴표로 감싼다.

# ─── 이미지 ───────────────────────────────────────────────────────────────
# 앱 태그 하나(가능하면 @sha256 digest). migrate와 web이 같은 값을 쓴다.
MALMOI_IMAGE=ghcr.io/sinhyeokkang/malmoi:v0.0.0

# ─── DB 롤 비밀번호 셋 — 서로 다르게, URL에 그대로 들어가므로 hex로 만든다(`openssl rand -hex 32`) ───
# superuser — postgres 컨테이너만 받는다(초기화 전용).
POSTGRES_PASSWORD=
# 마이그레이션 롤(DB 소유 비-superuser) — migrate만 받는다. 첫 기동(빈 볼륨) 뒤 바꾸려면 ALTER ROLE을 직접 친다.
MIGRATE_DB_PASSWORD=
# 런타임 롤(DML만) — bootstrap이 만들고 web이 붙는다. 이미 있으면 bootstrap이 바꾸지 않는다.
RUNTIME_DB_PASSWORD=

# ─── 이 설치 ──────────────────────────────────────────────────────────────
# 공개 HTTPS origin(경로·query 없음). AUTH_URL도 이 값이 된다. nginx 예제의 server_name과 같은 호스트다.
MALMOI_ORIGIN=https://malmoi.example.com
# 운영자 개인정보 방침의 HTTPS URL — 이 설치의 /privacy를 가리키면 preflight가 거부한다.
MALMOI_PRIVACY_URL=https://example.com/privacy
# 선택: 프로젝트 상한 예외가 될 운영자 이메일(쉼표 구분). 비우면 운영자도 상한 3이다.
OPERATOR_EMAILS=

# ─── 로그인(Auth.js) — callback: <MALMOI_ORIGIN>/api/auth/callback/{github,google} ─────────
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── 앱 서명 — AUTH_SECRET·암호화 키와 다른 값 ──────────────────────────────
APP_SIGNING_SECRET=

# ─── GitHub App(운영자가 만든 App) ─────────────────────────────────────────
GITHUB_APP_ID=
# PEM을 한 줄로 — 개행은 `\n` 문자열로 넣는다(앱이 복원한다).
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=

# ─── 야간 pull — web과 scheduler가 같은 값을 받는다 ───────────────────────────
CRON_SECRET=

# ─── 자격증명·개인정보 암호화 키 여섯 — 형식은 리포 루트 .env.example ─────────────────
# keyring JSON은 작은따옴표로 감싼다: TOKEN_ENCRYPTION_KEYS='{"k1":"<32바이트 base64>"}'
TOKEN_ENCRYPTION_KEYS=
TOKEN_ENCRYPTION_ACTIVE_KEY_ID=
PII_ENCRYPTION_KEYS=
PII_ENCRYPTION_ACTIVE_KEY_ID=
EMAIL_LOOKUP_KEY=
EMAIL_LOOKUP_KEY_ID=

# ─── 초대 메일(Resend) — self-hosted에서는 필수다 ─────────────────────────────
RESEND_API_KEY=
INVITATION_EMAIL_FROM="Malmoi <invite@malmoi.example.com>"
