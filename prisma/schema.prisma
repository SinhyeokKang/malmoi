// 테이블 정의의 근거는 docs/MVP.md §6, 설계 판단은 docs/ARCHITECTURE.md §5.
// 접속 URL은 여기 없다 — Prisma 7은 prisma.config.ts에서 읽는다.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 테넌트 경계. **편집 경로는 멀티테넌트다** (2026-09-05) — 프로젝트는 URL의 slug, 권한은 `ProjectMember`.
/// ✅ **두 라우트도 단일 프로젝트 가정을 벗어났다** (2026-09-07): push는 `pushTokenHash`가 프로젝트를 정하고,
/// cron은 준비된 전 프로젝트를 순회한다. 공유 slug env를 읽는 코드가 남아 있지 않다.
/// 이 경계를 PoC 때 미리 넣은 이유는 나중에 넣으면 복합 unique·복합 PK가 실데이터 이관을 요구하기
/// 때문이었다(아래 각 모델 주석). 나머지는 전부 additive로 붙었다.
model Project {
  id   String @id @default(cuid())
  slug String @unique
  name String

  /// 대상 리포. 초기엔 환경변수였다가 여기로 내려왔다 — 고객마다 리포가 다르다.
  repoOwner  String
  repoName   String
  baseBranch String @default("main")

  /// GitHub App **설치** id. App 자체(GITHUB_APP_ID·PRIVATE_KEY)는 앱 단위라 환경변수에 남고,
  /// 설치는 고객이 각자 하므로 여기 둔다. 미설치 상태를 표현해야 해서 nullable이다.
  installationId String?
  repositoryId String?

  // ── 로케일 포맷 (온보딩이 확정하고 pull이 읽는다) ─────────────────────────
  // 원래는 push가 채우는 값이었다(CI가 리포를 탐지한다). 2026-09-07 온보딩이 **사용자에게 확정받아**
  // 재검증한 값을 생성 시점에 심으므로, 그 뒤의 push는 **같은 표면일 때만** 통과한다
  // (`lib/push/guard.ts`의 `checkFormat` — 409). 셋이 다 null인 행에는 첫 push가 그대로 채운다.
  // ⚠️ **셋은 항상 함께 쓰인다** — 일부만 채워진 상태를 만드는 코드 경로가 없고, 그런 행은
  // fail-closed로 거부된다. 아직 아무 push도 받지 않은 프로젝트를 표현해야 해서 전부 nullable이다.

  /// 어댑터 이름 — `lib/adapters/types.ts`의 `AdapterName` 5종(`chrome-locales`·`json-catalog`·`yaml-catalog`·`code-dict`·`ts-dict`).
  /// 문자열 컬럼이라 DB가 제약하지 않는다 — pull이 `isAdapterName`으로 거른다.
  adapterName  String?
  /// per-locale 어댑터는 `{locale}`을 치환하면 실제 경로가 된다(`src/lib/i18n/{locale}.json`).
  /// **multi-locale 어댑터(`ts-dict`)는 한 파일에 로케일이 여러 개라 글롭이다** (`src/i18n/namespaces/*.ts`).
  pathTemplate String?
  /// 원본이 중첩 JSON이었는지. **경로만으로는 알 수 없어** read가 관측한 값을 push가 전달한다.
  ///
  /// ⚠️ **거친 값이다** — 로케일 파일 하나라도 중첩이면 true다. 정확한 값은 아래 nestedByPath이고,
  /// write는 그쪽을 먼저 본다. 이 컬럼은 폴백용이자 하위 호환용으로 남는다.
  nested       Boolean?
  /// 로케일 파일 경로 → 그 파일이 중첩이었는지 (`{"i18n/th.json": false}`).
  ///
  /// 포맷 단위 boolean만 두면 형제 파일 하나 때문에 **평평한 파일의 점 포함 키가 쪼개지고 값이
  /// 사라진다** — musicblocks 84로케일 중 81개에서 각 4키가 그렇게 없어졌다 (ARCHITECTURE §1.35).
  /// Json인 이유: 로케일 수가 리포마다 다르고(실측 최대 106개) 조회 조건이 아니라 write 입력이다.
  nestedByPath Json?
  /// 키 집합을 정의하는 기준 로케일 — **현실**이다. CI가 보낸 값을 저장한다(소유자는 `applyPush`) —
  /// 고르는 규칙(`pickBaseLocale`: en 우선, 없으면 사전순)은 리포 관례를 추정한 것이고 정본은
  /// 미결이다 (TASKS §3a 🔒 / MVP §10). **pull과 `checkFormat`이 이 값을 읽는다.**
  baseLocale   String?
  /// 기준 로케일 변경의 **선언** — "다음 CI push가 이 base를 가져오면 받아들이겠다"는 OWNER의
  /// **일회용 허가**다 (6b-3 — translation-ui design §3.13).
  ///
  /// ⚠️ **소유자와 읽는 곳이 위 컬럼과 다르다**: 쓰는 것은 설정 화면(`updateRepositorySettings`)이고
  /// 읽는 것은 `checkFormat`(선언과 같은 base도 통과시킨다)과 두 화면의 대기 배너(`basePending`)다.
  /// **pull은 이 컬럼을 보지 않는다** — 그래서 대기 중에도 옛 base로 정상 동작하고 어느 단계도
  /// 멈추지 않는다. 같은 컬럼에 선언을 쓰면 pull이 그것을 즉시 진실로 읽어 옛 base의 원문이 새
  /// base 파일에 실린 PR을 낸다(그 안을 기각한 근거다).
  ///
  /// `applyPush`가 push 성공 시 **null로 비운다** — 안 비우면 한 번 허가한 base가 영구 예외가 된다.
  declaredBaseLocale String?

  /// 마지막 push의 커밋 SHA. 편집 UI의 코드 참조 permalink 기준이다.
  /// `KeyRef`가 push마다 전체 교체되므로 프로젝트당 값 하나로 충분하다 — ref마다 들 필요가 없다.
  lastCommitSha String?

  /// 마지막 push의 **커밋 시각**. 다음 push가 이보다 과거면 409로 거부한다 (ARCHITECTURE §5.5.5).
  /// strict라 오래된 run의 Re-run이 DB를 그 시점으로 되돌리는데 복구 경로가 없다.
  /// SHA로는 순서를 알 수 없어 시각을 따로 든다.
  lastCommitAt DateTime?

  /// CI가 `/api/push`를 부를 때 쓰는 토큰의 sha256. **원문은 저장하지 않는다** (SAAS §7.8 —
  /// `ProjectInvitation.tokenHash`와 같은 모델, 같은 해시 규칙 `lib/push/token.ts`). 인증은 이 값으로 행을
  /// **조회**한다 — 토큰이 프로젝트를 정하고 slug는 그 뒤에 대조된다. 페이로드 slug로 행을 찾으면 오배송
  /// 페이로드가 인증 대상을 고른다 (design §3.8).
  /// null이면 아직 발급 전이고 **어떤 push도 통과하지 못한다** (fail-closed — 서버 설정이 아니라 그 프로젝트의
  /// 상태라 500이 아니라 401이다). Postgres unique는 NULL 여럿을 허용하므로 기존 행에 무해하다.
  pushTokenHash String? @unique

  /// 마지막으로 성공한 pull의 기준 시각 — **1층 DB 측 스킵**의 비교 대상이다 (ARCHITECTURE §2).
  /// `Translation.updatedAt`의 최대값이 이 값을 넘지 않았으면 GitHub을 한 번도 부르지 않고 끝낸다.
  ///
  /// 넣는 값은 `now()`가 아니라 **판정 시점에 캡처한 `max(updatedAt)`** 이다. `now()`를 쓰면
  /// export 스냅샷과 갱신 사이에 들어온 편집이 다음 실행에서 영영 스킵된다.
  /// **2층(blob SHA 전부 동일)으로 끝난 경우에도 갱신한다** — 그 순간 export == base 트리가
  /// 검증된 상태이고, 안 갱신하면 값 불변 push 한 번 뒤 매일 밤 트리를 다시 읽는다.
  /// 중간 실패 시에는 쓰지 않는다(실패한 pull이 다음 실행을 스킵시키면 편집이 영영 안 나간다).
  lastPulledAt DateTime?

  /// 마지막으로 **PR을 만들거나 갱신한** Publish 시각. `skipped`는 쓰지 않는다 — "보낸" 것만 센다
  /// (translation-ui design §3.4). ⚠️ **`lastPulledAt`과 뜻이 다르다**: 그쪽은 벽시계가 아니라 캡처된
  /// `max(updatedAt)`이고 변경 없는 스킵에도 전진한다. 미배포 집계의 기준은 그쪽이고, 이 컬럼은
  /// 툴바의 "Last sent"가 읽는다.
  lastPublishedAt DateTime?

  /// 그때의 PR URL — 새로고침을 넘어 남는다. **머지 여부는 저장하지 않는다**: 웹훅이 비범위라(SAAS §4.3)
  /// 알 수 없고, 링크를 누르면 GitHub이 답한다.
  lastPrUrl String?

  /// 보관 시각. **되돌릴 수 있는 사실 하나**이지 상태 머신이 아니다 — `Locale.orphaned`·
  /// `StringKey.orphaned`와 같은 형이고, SAAS §7.5가 "별도 상태 컬럼을 즉시 만들지 않는다"고 이미 정했다.
  ///
  /// 값이 있으면 **`project:settings`를 제외한 모든 권한이 `archived`로 거부된다**(`planProjectAccess`) —
  /// 편집·Publish가 멈추고, 야간 cron의 순회에서 빠지고(`selectPullTargets`), CI push는 409다.
  /// ⚠️ **목록에서 숨기지 않는다** — 숨기면 되돌릴 링크에 도달할 길이 없다. 배지로 남는다.
  /// ⚠️ **열린 PR을 닫지 않는다** (SAAS §7.9) — 보관은 "멈춘다"이고 GitHub 상태를 정리하는 일이 아니다.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locales Locale[]
  keys    StringKey[]

  // 역관계는 가상 필드다 — 컬럼이 생기지 않으므로 이 추가는 additive를 깨지 않는다.
  members     ProjectMember[]
  invitations ProjectInvitation[]
  syncRuns    SyncRun[]
}

/// 프로젝트별 지원 로케일. isBase가 키 집합을 정의하는 기준 로케일이다.
///
/// **복합 PK를 쓴다** — 고객마다 `ko`의 name·isBase가 다를 수 있으므로 code 단독 PK가 성립하지
/// 않는다. 이게 나중에 바꾸면 비싼 두 지점 중 하나다(Translation의 FK까지 함께 복합이 된다).
model Locale {
  projectId String
  code      String
  name      String
  isBase    Boolean @default(false)

  /// 리포에서 사라진 로케일. **행을 지우지 않는다** — 키의 orphaned와 같은 근거다: 파일을 되살리면
  /// 번역이 그대로 돌아와야 하고, Translation의 FK가 Restrict라 지우려면 번역을 먼저 지워야 한다.
  ///
  /// 로케일 목록의 정본은 어댑터가 탐지한 파일 목록이고(MVP §3.1) push가 이 값을 맞춘다. **pull이
  /// 이 로케일의 파일을 내지 않는다** — 안 그러면 개발자가 지운 fr.json이 다음 PR에서 되살아난다.
  orphaned  Boolean @default(false)

  /// Restrict — 번역이 달린 프로젝트를 지우려 하면 DB가 거부한다. Cascade면 프로젝트 삭제가
  /// 번역을 조용히 날린다. 프로젝트 삭제가 필요해지면 soft delete로 푼다.
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  translations Translation[]

  @@id([projectId, code])
}

/// 소스 키. **코드가 진실**이므로 push만 이 테이블을 쓴다.
model StringKey {
  id        String @id @default(cuid())
  projectId String
  key       String

  /// 키에서 파생되는 값이지만 컬럼으로 저장한다 — 사이드바 쿼리가 이 컬럼 하나로 끝나고,
  /// 매번 파싱하면 인덱스를 못 탄다.
  namespace   String
  sourceText  String
  /// 원문 비교용 해시. 문자열 직접 비교보다 인덱스가 작고 비교가 싸다(긴 원문이 많다).
  sourceHash  String
  description String?
  /// base 로케일 **파일 안에서의** 키 위치. 파일 순서를 보존해 첫 pull PR을 사람이 읽을 수 있게
  /// 한다 (MVP §4.1). 없으면 순서를 모르는 키 — 재생성 writer가 코드 유닛 순으로 뒤에 붙인다.
  ///
  /// ⚠️ **파일 스코프다.** 파일이 여럿인 레이아웃에서는 common.json의 3번째 키와 settings.json의
  /// 3번째 키가 둘 다 2다 — 파일 경계를 넘어 비교할 수 없다.
  ///
  /// 인덱스를 붙이지 않는다: pull이 projectId로 좁힌 뒤 정렬하고 이 규모에서 키가 수천 개다.
  sortIndex   Int?
  /// 코드에서 사라진 키. **삭제하지 않는다** — 브랜치를 되돌리거나 기능을 복구하면
  /// 번역이 그대로 살아 돌아와야 한다. export에서만 빠진다.
  orphaned    Boolean @default(false)

  updatedAt DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  refs         KeyRef[]
  translations Translation[]

  /// 키 이름은 **프로젝트 안에서만** 유일하다. 전역 unique면 두 고객이 `common.ok`를 동시에
  /// 못 쓴다. 나중에 바꾸면 비싼 두 지점 중 나머지 하나다.
  @@unique([projectId, key])

  /// Translation이 복합 FK로 이걸 참조해 **테넌트 간 참조를 DB가 막는다** (아래 Translation 주석).
  /// id가 이미 PK라 중복처럼 보이지만, 복합 FK의 대상이 되려면 이 unique가 필요하다.
  @@unique([projectId, id])

  /// 모든 조회가 프로젝트로 먼저 좁혀지므로 선두 컬럼이 projectId여야 인덱스를 탄다.
  /// namespace·orphaned 단독 인덱스는 이 구조에서 쓸모가 없다.
  @@index([projectId, namespace])
  @@index([projectId, orphaned])
}

/// 키의 코드 사용처. push마다 **전체 교체**한다 — 증분 갱신은 삭제 케이스를 놓치기 쉽고,
/// 스캔이 전수라 교체가 더 정확하고 단순하다.
///
/// projectId를 두지 않는다 — FK가 하나뿐이라 테넌트 간 참조가 성립할 수 없고, 프로젝트 단위
/// 삭제는 관계를 타면 된다(`where: { stringKey: { projectId } }`). 쓰지 않을 비정규화는 안 한다.
model KeyRef {
  id    String @id @default(cuid())
  keyId String
  path  String
  line  Int

  stringKey StringKey @relation(fields: [keyId], references: [id], onDelete: Cascade)

  @@index([keyId])
}

/// 번역 값. **push가 리포 값으로 덮는다** (strict — `INSERT … ON CONFLICT DO UPDATE`, MVP §3.1).
/// push 사이에는 DB가 진실이고 pull이 리포로 되돌린다 — 어느 시점에도 두 쪽을 병합하지 않는다.
/// 쓰기 주체는 둘뿐이다: 편집 UI의 `saveTranslation`과 push (ARCHITECTURE §5.5.2).
model Translation {
  id String @id @default(cuid())

  /// ⚠️ projectId를 별도로 들고 있는 이유는 비정규화가 아니라 **테넌트 격리**다.
  /// keyId와 localeCode를 독립 FK로 두면 프로젝트 A의 키에 프로젝트 B의 로케일을 붙인 행을
  /// DB가 허용한다. 두 FK가 같은 projectId 컬럼을 공유하게 만들어 그 조합을 불가능하게 한다.
  projectId  String
  keyId      String
  localeCode String
  value      String

  /// **그 로케일 파일이 실제로 갖고 있던** description. chrome `_locales`에만 있다.
  ///
  /// ⚠️ `StringKey.description`(소스 키 메타데이터)과 **다른 것이다.** 저쪽을 이쪽 대신 쓰면
  /// base 값을 비-base 파일에 복제하게 되고, 그건 원본에 없던 값을 만드는 것이라 병합이다.
  description  String?
  /// chrome `placeholders` 블록을 **해석하지 않고 그대로** 보관한다.
  ///
  /// 구조를 검증하기 시작하면 크롬 스펙을 따라다녀야 하는데, 이 컬럼이 요구하는 것은
  /// "잃지 않는다"뿐이다. 모양이 이상해도 버리지 않는다 — 거르면 원본에 있던 것이 우리 PR에서
  /// 조용히 사라진다 (`lib/adapters/types.ts`의 `LocaleEntry.placeholders`와 같은 계약).
  placeholders Json?

  /// 원문(sourceHash)이 바뀌었을 때 push가 세운다. 미번역/번역됨/검토필요 3상태가
  /// 이 플래그 하나와 행 존재 여부로 표현된다.
  needsReview Boolean @default(false)
  /// 편집자 식별자. **2026-09-05부터 `User.id`다** (`app/(edit)/actions.ts`). 그 전 행은 GitHub 핸들을
  /// 그대로 들고 있다 — 컬럼 타입은 바뀌지 않았다.
  ///
  /// **FK를 걸지 않는다.** 두 종류의 값이 섞인 컬럼이라 참조 무결성을 주장할 수 없다 — `User`에 join하면
  /// 옛 행은 한 행도 못 찾는다. `User.id`를 쓰는 이유는 이메일이 재할당될 수 있어서다 (SAAS §5.6).
  updatedBy   String?

  updatedAt DateTime @updatedAt

  /// 두 관계가 projectId를 공유한다 — 이것이 테넌트 간 참조를 막는 장치다.
  /// onDelete: Restrict — "키를 삭제하지 않고 orphaned로 둔다"는 코어 불변식을 DB가 강제한다.
  stringKey StringKey @relation(fields: [projectId, keyId], references: [projectId, id], onDelete: Restrict)
  locale    Locale    @relation(fields: [projectId, localeCode], references: [projectId, code], onDelete: Restrict)

  /// 이 제약이 없으면 중복 행이 생겨 export가 비결정적이 된다 — ARCHITECTURE §1 불변식이
  /// 스키마에 의존하는 지점이다. projectId는 keyId에 함수 종속이라 키에 넣지 않는다.
  @@unique([keyId, localeCode])
  @@index([projectId, localeCode, needsReview])

  /// **pull 1층 판정 전용.** `aggregate({ where: { projectId }, _max: { updatedAt } })`가 이 인덱스를
  /// 역방향으로 타 첫 행에서 멈춘다. 없으면 그 프로젝트의 Translation 전체를 훑는데, 야간 cron이
  /// **매일** 부르는 쿼리라 조용히 느려지고 어느 게이트에도 안 나타난다 (2026-09-04 audit #45).
  /// 위 인덱스로는 대체되지 않는다 — `localeCode`가 제약되지 않아 MAX가 스킵 스캔을 못 한다.
  @@index([projectId, updatedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// SaaS 2단계 — 인증·인가 (docs/SAAS.md §6, docs/features/tenant-auth/design.md §5)
//
// ⚠️ **아래 네 모델의 모양은 우리가 정한 것이 아니라 `@auth/prisma-adapter`가 요구하는 것이다.**
// 타입 검사가 그 계약을 못 본다(어댑터 파라미터가 사실상 `any`다 — 근거는
// `prisma/__tests__/schema-contract.test.ts` 헤더). **그 테스트가 유일한 자동 방어선이므로
// 여기를 고치면 그쪽이 red가 되는지 확인한다.**
// ─────────────────────────────────────────────────────────────────────────────

/// 프로젝트 역할. **둘뿐이다** — MVP §7의 "세밀한 권한" 비범위가 SaaS에서도 유지된다 (SAAS §3).
/// Publish는 별도 역할·권한이 아니라 EDITOR가 할 수 있는 일에 포함된다(`lib/auth/permission.ts`).
enum Role {
  OWNER
  EDITOR
}

/// sync 실행의 끝 상태. **`SKIPPED`가 `SUCCEEDED`와 갈려 있다** — `lastPublishedAt`이 skipped에서
/// 안 움직이므로("마지막으로 **보낸**" 것이지 시도한 것이 아니다) 그 구별이 행에도 남아야
/// `logs`가 "어제 밤엔 보낼 게 없었다"와 "어제 밤에 보냈다"를 가른다.
enum SyncStatus {
  RUNNING
  SUCCEEDED
  SKIPPED
  FAILED
}

enum SyncTrigger {
  MANUAL
  CRON
}

/// **시작한 sync 실행 하나.** 편집 UI의 [Send changes]와 야간 cron이 같은 껍데기(`lib/sync/run.ts`)를
/// 지나고 그것이 이 행을 만든다.
///
/// ⚠️ **행은 시작한 실행에만 생긴다** (design 결정 6). 게이트에서 거부된 것(`already-running`·`too-soon`·
/// 보관·not-ready)은 행이 없는 것이 정상이다 — 첫 실행의 `RUNNING` 행이 그 사건의 증거다.
/// 중단된 프로세스가 남긴 `RUNNING`은 다음 실행이 `FAILED`/`errorCode: "stale"`로 **닫는다**.
///
/// ⚠️ **`type`·`idempotencyKey`가 없다.** SAAS §8이 두 이름을 적어 뒀지만 지금 두 진입점 중 **키를 만들
/// 주체가 없다**(cron은 하루 한 번, UI는 클릭이다). 동시성은 `Project` 행 잠금이 막는다. 둘 다
/// **push를 이 테이블에 넣을 때** 의미가 생기고(같은 커밋의 Re-run이 그 키다) 그날 additive로 붙인다 —
/// "확장성을 위한 선반영은 그 자체가 결함이다".
model SyncRun {
  id        String      @id @default(cuid())
  projectId String
  status    SyncStatus
  trigger   SyncTrigger

  /// 누가 눌렀나. cron이면 null이다.
  ///
  /// ⚠️ **FK를 든다** — `Translation.updatedBy`가 FK를 못 가진 사정(User.id와 옛 GitHub 핸들이 섞여 있다,
  /// malmoi#3)이 새 테이블엔 없다. `SetNull`이라 사용자가 지워져도 **실행 이력은 남고 저자만 빈다** —
  /// `Restrict`면 사용자 삭제가 이력 때문에 막힌다.
  requestedBy String?

  startedAt  DateTime  @default(now())
  /// 세 terminal 상태 전부에 선다. `RUNNING`인 동안만 null이다.
  finishedAt DateTime?

  /// `SyncErrorCode`(`lib/sync/plan.ts`) — **앱 층 어휘라 enum이 아니다.** 코드가 늘 때마다 마이그레이션을
  /// 요구하면 "던지는 자리가 코드를 든다"는 규칙이 배포에 묶인다. 읽는 쪽이 모르는 값은 폴백 문장으로 떨어진다.
  errorCode String?

  prUrl   String?
  /// 바꾼 파일 수. **실패는 null이다** — 0은 "아무것도 안 바뀌었다"는 관측이고 실패엔 관측 자체가 없다.
  changed Int?
  /// writer가 **버린** 항목 수. skipped에도 센다 (SAAS 불변식 9).
  warnings Int @default(0)

  /// Restrict — `Project`의 기존 관계 전부와 같은 근거다. Cascade면 프로젝트 삭제가 이력을 조용히 날린다.
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  requester User?   @relation(fields: [requestedBy], references: [id], onDelete: SetNull)

  /// `Translation`의 `[projectId, updatedAt]`과 같은 형 — `logs`도 게이트 조회도 **역방향으로 탄다**
  /// (최신 몇 건). 별도 sort 인덱스를 두지 않는다.
  @@index([projectId, startedAt])
}

/// 로그인 사용자. **`email`이 unique인 것은 어댑터의 `getUserByEmail`이 `findUnique`이기 때문이다.**
///
/// ⚠️ **`emailVerified`는 OAuth 로그인에서 채워지지 않는다** — 어댑터가 그 값을 이메일 provider
/// 전용으로 쓴다. 우리의 이메일 검증은 `signIn` 콜백이 provider claim을 보고 판정한다
/// (design §2.1) — 이 컬럼을 그 판정의 근거로 읽으면 안 된다.
model User {
  id            String    @id @default(cuid())
  name          String?
  /// 정규화된 주소를 저장한다(`normalizeEmail` — trim + 소문자). 원문을 저장하면 대조가 갈린다.
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts        Account[]
  sessions        Session[]
  memberships     ProjectMember[]
  invitationsSent ProjectInvitation[]
  syncRuns        SyncRun[]
}

/// OAuth provider 연결. **컬럼 이름이 snake_case인 것은 OAuth 응답 필드를 그대로 받기 때문이다** —
/// 어댑터의 `linkAccount`가 `AdapterAccount`를 통째로 `create({ data })`에 넘기므로 **하나라도
/// 없으면 Prisma가 `Unknown argument`로 던진다.** 안 쓰는 값이라고 빼면 로그인이 깨진다.
///
/// ⚠️ **자동 계정 병합을 하지 않는다** (SAAS §5.5). 어댑터 기본값이 이미 그렇고
/// (`allowDangerousEmailAccountLinking` 미설정), 같은 이메일의 다른 provider는
/// `OAuthAccountNotLinked`로 거부된다. **그 옵션을 어느 provider에도 켜지 않는 것**이 방어선이다.
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  /// Cascade다 — 어댑터의 `deleteUser`가 `user.delete` 하나만 부르므로 Restrict면 그 메서드가
  /// 항상 실패한다. **우리 데이터(`ProjectMember`)는 반대로 Restrict다** — 아래.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 어댑터가 `where: { provider_providerAccountId }`로 조회한다. 별도 `id` 컬럼을 두지 않는다 —
  /// 어댑터가 그 값을 읽는 곳이 없다.
  @@id([provider, providerAccountId])
}

/// DB 세션. **JWT에서 여기로 옮긴 이유는 권한 회수 지연이다** — JWT는 목록에서 뺀 사람이 최대
/// 24시간 편집할 수 있었다 (MVP §5 → SAAS §5.3). 대가는 요청마다의 DB 왕복이다.
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  /// Cascade — Account와 같은 이유.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// 어댑터가 요구하는 테이블. **이메일 provider를 쓰지 않으므로 항상 비어 있다** (SAAS §4.3 ①) —
/// 매직링크는 메일 인프라 운영을 끌고 와서 1차에서 뺐다. 어댑터의 두 메서드가 이 델리게이트를
/// 부르므로 테이블 자체는 있어야 한다.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

/// **권한의 유일한 정본** (SAAS §9 불변식 7 — 로그인 provider가 아니라 이 행이 권한을 정한다).
///
/// ⚠️ 이 행이 없는 `Project`는 **아무도 접근할 수 없다.** 기존 프로젝트에 OWNER를 채우는 것이
/// 인가 전환 앞의 필수 단계다 (design §5 배포 순서 2).
model ProjectMember {
  projectId String
  userId    String
  role      Role

  createdAt DateTime @default(now())
  /// SAAS §6이 `AuditEvent`를 미룬 근거가 이 컬럼이다 — 역할 변경 시각이 여기 남는다.
  updatedAt DateTime @updatedAt

  /// Restrict 둘. 기존 `Project` 관계 전부가 Restrict인 것과 같은 근거다 (ARCHITECTURE §5):
  /// Cascade면 프로젝트·사용자 **삭제**가 소유권을 조용히 날린다. ⚠️ **멤버 행의 제거·강등은 FK가 막지
  /// 않는다** — "마지막 OWNER 보호"는 `changeMember`의 트랜잭션(프로젝트 행 잠금 + 쓰기 뒤 재집계)이
  /// 유일한 방어선이다 (Codex 감사 2026-09-06 #2).
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// 한 프로젝트에 사용자당 한 행. 이 제약이 `planMemberChange`의 "멤버 목록"을 유일하게 만든다.
  ///
  /// ⚠️ **`userId` 단독 인덱스를 두지 않는다.** `/projects` 목록이 userId로 조회하지만, SAAS §8
  /// 7단계의 고정 제한(사용자당 프로젝트 3 · 프로젝트당 멤버 10)이 이 테이블을 수십 행으로 묶는다.
  /// 실제로 느려지는 것이 관측되면 그때 넣는다.
  @@unique([projectId, userId])
}

/// 수락 전 초대. **토큰 원문을 저장하지 않는다** — 발급 시 한 번 보여주고 sha256 해시만 남긴다
/// (SAAS §5.6, `lib/auth/invitation.ts`).
model ProjectInvitation {
  id        String @id @default(cuid())
  projectId String
  /// 정규화된 주소. 수락 시 **provider가 검증한 이메일**과 대조한다 (design §2.1).
  email     String
  role      Role
  /// 링크로 행을 찾는 유일한 키다. 원문은 발급 시 한 번만 보이고 저장하지 않는다.
  tokenHash String   @unique
  expiresAt DateTime
  /// 수락 시각. **행을 지우지 않는다** — 재사용 시도를 `already-accepted`로 구별해야 한다
  /// (`planInvitationAccept`). 지우면 그 시도가 `not-found`가 되어 만료·오배송과 뭉개진다.
  acceptedAt DateTime?
  /// 초대한 사람의 `User.id`.
  invitedBy  String
  createdAt  DateTime @default(now())

  project     Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  invitedByUser User  @relation(fields: [invitedBy], references: [id], onDelete: Restrict)

  /// ⚠️ **unique가 아니라 index다.** `acceptedAt`을 남기는 설계라 수락·만료된 행이 이메일을
  /// 점유하는데, unique면 **멤버를 뺐다가 다시 부르는 정상 경로가 제약 위반**이 된다.
  /// 행이 여럿이어도 `planInvitationAccept`가 `expired`·`already-accepted`를 가르므로 판정은 선다.
  @@index([projectId, email])
}
